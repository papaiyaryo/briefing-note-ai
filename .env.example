# OpenAI
OPENAI_API_KEY=

# Google Drive / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_NAME=briefing-note-ai

# OpenAI provider switch / models (Phase 6)
OCR_PROVIDER=
STRUCTURE_PROVIDER=
OPENAI_OCR_MODEL=
OPENAI_STRUCTURE_MODEL=
WEB_SUPPLEMENT_PROVIDER=
OPENAI_WEB_SUPPLEMENT_MODEL=
WEB_SUPPLEMENT_ENABLED=
INTERVIEW_REVIEW_PROVIDER=
OPENAI_INTERVIEW_REVIEW_MODEL=

# 企業・メモ保存：すべてserver-only。実値は未追跡.env.local等へ記入する。
# Supabase Project Settings > API: project URL / publishable key（旧anonも可）
# secret/service_roleキーは使用しない。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Auth Usersで作成した本人UUID。公開登録/匿名ログインを停止してから使用する。
WORKSPACE_ALLOWED_USER_ID=
# 許可Originのみ。path/末尾slashなし。実環境はhttps必須。
WORKSPACE_ORIGIN=
# pg接続文字列：非公開schemaの通常role。sslmode等のqueryを付けずCAを別指定。
WORKSPACE_DATABASE_URL=
WORKSPACE_DATABASE_CA=
WORKSPACE_DB_SCHEMA=
# 別々の32-byte暗号乱数鍵をbase64化。各欄に {"active":"key-id","keys":{"key-id":"base64"}}。
# TOKENはsession暗号化用、RECEIPTは生成出自用。鍵を共有しない。
WORKSPACE_TOKEN_KEYS=
WORKSPACE_RECEIPT_KEYS=
# 実環境はsupabase（空欄も同じ）。dummyへの自動fallbackなし。
WORKSPACE_AUTH_MODE=
# 次の2欄はローカル開発専用。production/非loopbackでは拒否される。
WORKSPACE_DB_ALLOW_LOCAL=
WORKSPACE_DUMMY_PASSWORD=
# 実APIを使わない使い捨てPostgreSQL試験の接続先（通常は空で既定local DB）。
U1_TEST_DATABASE_URL=


GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECEIVER_ADDRESS=
